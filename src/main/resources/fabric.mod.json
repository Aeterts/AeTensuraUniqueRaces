{
  "schemaVersion": 1,
  "id": "tensura_unique_races_fabric",
  "version": "${version}",
  "name": "Tensura: Unique Races (Fabric)",
  "description": "Add-on for Tensura: Reincarnated. Each race can be taken by a limited number of players on a server (by default one). Server-side, works in multiplayer.",
  "authors": [
    "Aeterts"
  ],
  "contact": {
    "homepage": "https://modrinth.com/project/tensura-unique-races",
    "sources": "https://github.com/Aeterts/TensuraUniqueRaces-Fabric",
    "issues": "https://github.com/Aeterts/TensuraUniqueRaces-Fabric/issues"
  },
  "license": "MIT",
  "icon": "assets/tensura_unique_races_fabric/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "org.aeterts.tensuraunique.TensuraUniqueRaces"
    ]
  },
  "mixins": [
    "tensura_unique_races_fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.10",
    "minecraft": "~${minecraft_version}",
    "java": ">=21",
    "fabric-api": "*",
    "architectury": ">=13.0.8",
    "tensura": ">=2.0.1.3",
    "manascore_race": ">=4.0.0.2"
  }
}
